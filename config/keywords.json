{
  "_instructions": "News keyword groups. Each group becomes one Google News RSS query (terms OR-joined). Edit freely: add/remove terms or groups. 'id' is the filter-button key; 'label' is what the page shows. Multi-word terms are quoted automatically. Items found by several groups get several tags.",
  "_filters_note": "Drop items whose source contains any blocked_sources entry, or whose headline matches any exclude_title_patterns (case-insensitive regex) \u2014 used to keep out quote pages, spam sites and sell-side rating/target/estimate headlines. Per group, require_any (optional) keeps only items whose headline+snippet contains one of the strings.",
  "lookback_days": 90,
  "blocked_sources": [
    "dars.gov.et",
    "marketbeat",
    "stock titan",
    "gurufocus",
    "zacks",
    "tipranks",
    "benzinga",
    "investing.com",
    "marketscreener",
    "seeking alpha",
    "simply wall st",
    "kalkine",
    "stock traders daily",
    "moomoo",
    "facebook"
  ],
  "exclude_title_patterns": [
    "stock price, news, quote",
    "interactive stock chart",
    "price target",
    "target price",
    "\\brating\\b",
    "\\banalysts?\\b",
    "\\bupgrade[sd]?\\b",
    "\\bdowngrade[sd]?\\b",
    "initiates coverage",
    "estimates?\\b",
    "stock forecast",
    "undervalued",
    "fair value",
    "technical signals",
    "\\bForm 4\\b",
    "\\$\\d+ target"
  ],
