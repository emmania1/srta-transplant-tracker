{
  "_instructions": "News keyword groups. Each group runs one Google News RSS query per entry in 'queries' (terms OR-joined; or a single query from 'terms'). Terms with spaces are quoted automatically; a term that already contains a double quote is used verbatim, so '\"organ donors\" record' means the exact phrase plus the word record. Items found by several groups get several tags. 'id' is the filter-button key; 'label' is what the page shows. Groups with collapsed=true are shown in their own collapsed section on the page so they don't crowd the main feed. A group with exclude_human_interest=true also drops headlines matching digest.exclude_patterns.",
  "_filters_note": "Three filters, applied to every item: (1) blocked_sources \u2014 drop if the source contains any entry (junk aggregators, quote pages, spam sites). (2) exclude_title_patterns \u2014 always drop headlines matching these case-insensitive regexes (consensus-estimate/consensus-rating spam, quote pages, valuation clickbait). (3) analyst_actions \u2014 headlines matching analyst_actions.patterns (ratings, price targets, coverage) are kept ONLY if they also mention one of analyst_actions.companies; they get an extra 'analyst' tag. Per group, require_any (optional) keeps only items whose headline+snippet contains one of the strings. (4) blocked_url_patterns \u2014 once a Google News link is resolved to the publisher URL, drop items whose URL matches (quote/forecast/estimate pages).",
  "lookback_days": 90,
  "blocked_sources": [
    "dars.gov.et",
    "marketbeat",
    "stock titan",
    "gurufocus",
    "zacks",
    "tipranks",
    "seeking alpha",
    "simply wall st",
    "kalkine",
    "stock traders daily",
    "moomoo",
    "ad hoc news",
    "facebook"
  ],
  "blocked_url_patterns": [
    "/forecast",
    "/quote/",
    "/quotes/",
    "/symbols/",
    "estimates",
    "/stock-price"
  ],
  "exclude_title_patterns": [
    "consensus (estimate|rating)s?",
    "estimates? (beat|miss|surprise)",
    "eps (beat|miss|surprise)",
    "stock price, news, quote",
    "interactive stock chart",
    "stock forecast",
    "undervalued",
    "fair value",
    "technical signals",
    "\\bForm 4\\b",
    "\\([A-Z.]{1,6}\\)\\s+(upgraded|downgraded)\\s+to\\s+(strong\\s+)?(buy|hold|sell)\\b",
    "what does it mean for the stock",
    "stock quote",
    "quote,? price (and|&) forecast",
    "\\bstock (price|quote) (today|history)\\b"
  ],
  "analyst_actions": {
    "tag": "analyst",
    "label": "Analyst actions (SRTA / TMDX)",
    "companies": [
      "strata critical",
      "srta",
      "transmedics",
      "tmdx"
    ],
    "patterns": [
      "price target",
      "target price",
      "\\$\\d+ target",
      "\\brating\\b",
      "\\banalysts?\\b",
      "\\bupgrade[sd]?\\b",
      "\\bdowngrade[sd]?\\b",
      "initiates coverage",
      "initiated coverage",
      "\\breiterates?\\b.*\\b(buy|hold|sell|outperform|overweight|underweight|neutral|rating)\\b",
      "\\bmaintains\\b.*\\b(buy|hold|sell|outperform|overweight)\\b"
    ],
    "drop": {
      "_note": "Zacks Rank changes (quant ranking, not a broker rating), incl. Zacks content republished on Yahoo. Dropped if source/headline/snippet mentions any 'mentions' entry, or the headline matches a 'patterns' regex (Zacks' passive '(TICKER) Upgraded to Buy' template; real broker actions name the broker).",
      "mentions": [
        "zacks"
      ],
      "patterns": [
        "\\([A-Z]{1,5}\\)\\s+(upgraded|downgraded)\\s+to\\s+(strong\\s+)?(buy|hold|sell)",
        "(upgraded|downgraded) to (strong )?(buy|hold|sell): what does it mean"
      ]
    }
  },
  "digest": {
    "_note": "How build_digest.py picks the 3-5 headlines for summary/latest.md. Category priority first, newest first within a category. Uses items published in the last primary_days; if fewer than min_items qualify, fills from the last fallback_days. An item qualifies only if its headline mentions an angle_terms entry and matches none of exclude_patterns (human-interest / awards / events).",
